# Required: GitHub org/repo to scrape (same as the GitHub URL path)
REPO=opendatahub-io/opendatahub-operator

# Optional: uncomment/edit to customize
# WATCH_WINDOW=24h
# BACKFILL_WINDOW=90d
# POLL_INTERVAL=300
# LOG_LEVEL=INFO
# WATCH_WORKERS=8
# BACKFILL_WORKERS=16
# GCS_NO_CACHE=true  # disable GCS artifact caching
