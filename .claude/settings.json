{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(document-reviewer)",
      "WebFetch(domain:grafana.com)",
      "WebFetch(domain:sre.google)",
      "WebFetch(domain:vector.dev)",
      "WebFetch(domain:opentelemetry.io)",
      "WebFetch(domain:docs.influxdata.com)",
      "WebFetch(domain:docs.victoriametrics.com)",
      "WebFetch(domain:storage.googleapis.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make build)",
      "Bash(make restart)",
      "Bash(make status)",
      "Bash(make test)",
      "Bash(make logs)",
      "Bash(make logs *)",
      "Bash(podman ps *)",
      "Bash(podman logs *)",
      "Bash(podman restart *)",
      "Bash(podman exec *)",
      "Bash(podman build *)",
      "Bash(python -m pytest *)",
      "Bash(python -m scraper backfill --dry-run *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__chrome-devtools__*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ensure-chrome-debug.sh"
          }
        ]
      }
    ]
  }
}
