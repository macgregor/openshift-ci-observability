# --- Cluster health / hibernation ---

def cmd_failure_hours(args):
    """Group failures by hour-of-day (UTC) to detect time-correlated patterns."""
    pattern = require_arg(args, "pattern")
    window = args[1] if len(args) > 1 else "14d"
    entries = vl_query(f'_time:{window} AND _msg:~"{pattern}"', 500)
    seen = set()
    hours = Counter()
    for e in entries:
        bid = e.get("build_id", "")
        if bid in seen:
            continue
        seen.add(bid)
        ts = e.get("_time", "")
        if len(ts) >= 13:
            hours[ts[11:13]] += 1
    for hour in sorted(hours):
        emit({"hour_utc": f"{hour}:00", "failure_count": hours[hour]})


def cmd_last_success(args):
    """Find the last successful build for a job, with the first failure after it."""
    job_pattern = require_arg(args, "job_pattern")
    results = vm_query(
        f'last_over_time({_OUTCOME}{{name="execution_completed",'
        f'job_name=~".*{job_pattern}.*"}}[{LOOKBACK}])'
    )
    builds = []
    for r in results:
        m = r["metric"]
        builds.append({
            "build_id": m.get("build_id", ""),
            "success": m.get("success", ""),
            "pr_number": m.get("pr_number", ""),
            "job_name": m.get("job_name", ""),
            "pr_sha": m.get("pr_sha", "")[:8],
        })
    builds.sort(key=lambda x: x["build_id"])
    successes = [b for b in builds if b["success"] == "true"]
    if not successes:
        emit({"status": "no_successes_found", "total_builds": len(builds)})
        return
    last = max(successes, key=lambda x: x["build_id"])
    result = {"last_success": last["build_id"], "pr_number": last["pr_number"],
              "pr_sha": last["pr_sha"], "job_name": last["job_name"]}
    later_failures = [b for b in builds if b["success"] == "false" and b["build_id"] > last["build_id"]]
    if later_failures:
        first_fail = min(later_failures, key=lambda x: x["build_id"])
        result["first_failure_after"] = first_fail["build_id"]
        result["first_failure_pr"] = first_fail["pr_number"]
    result["total_builds"] = len(builds)
    result["total_successes"] = len(successes)
    result["failures_since"] = len(later_failures)
    emit(result)


def cmd_test_failures(args):
    """Find failing test cases filtered by job and/or test name pattern."""
    job_pattern = args[0] if args else ""
    test_pattern = args[1] if len(args) > 1 else ""
    limit = int(args[2]) if len(args) > 2 else 50
    query_parts = ['source:junit_test AND status:failed']
    if job_pattern:
        query_parts.append(f'job_name:~{job_pattern}')
    if test_pattern:
        query_parts.append(f'test_name:~{test_pattern}')
    entries = vl_query(" AND ".join(query_parts), limit)
    builds = {}
    for e in entries:
        bid = e.get("build_id", "")
        test = e.get("test_name", "")
        key = f"{bid}:{test}"
        if key not in builds:
            builds[key] = True
            emit({
                "build_id": bid,
                "pr_number": e.get("pr_number", ""),
                "test_name": test,
                "msg": e.get("_msg", "")[:300],
                "time": e.get("_time", ""),
            })


# --- Cluster pool ---

def cmd_pool_health(args):
    """Cluster pool claim wait times and idle time statistics."""
    window = args[0] if args else "7d"
    # Claim wait time per pool
    wait_results = vm_query(
        f"avg by (cluster_pool) (avg_over_time("
        f"ci_cluster_claim_wait_seconds[{window}]))"
    )
    for r in wait_results:
        pool = r["metric"].get("cluster_pool", "unknown")
        avg_wait = round(val(r), 0)
        max_r = vm_query(
            f'max(max_over_time(ci_cluster_claim_wait_seconds'
            f'{{cluster_pool="{pool}"}}[{window}]))'
        )
        max_wait = round(val(max_r[0]), 0) if max_r else 0
        p90_r = vm_query(
            f'quantile(0.9, last_over_time(ci_cluster_claim_wait_seconds'
            f'{{cluster_pool="{pool}"}}[{window}]))'
        )
        p90_wait = round(val(p90_r[0]), 0) if p90_r else 0
        count_r = vm_query(
            f'count(last_over_time(ci_cluster_claim_wait_seconds'
            f'{{cluster_pool="{pool}"}}[{window}]))'
        )
        count = int(val(count_r[0])) if count_r else 0
        emit({
            "cluster_pool": pool,
            "builds": count,
            "avg_wait_s": avg_wait,
            "p90_wait_s": p90_wait,
            "max_wait_s": max_wait,
        })
    # Idle time (how long clusters sit before being claimed)
    idle_results = vm_query(
        f"avg by (cluster_pool) (avg_over_time("
        f"ci_cluster_idle_seconds[{window}]))"
    )
    for r in idle_results:
        avg_idle = round(val(r), 0)
        emit({
            "cluster_pool": r["metric"].get("cluster_pool", "unknown"),
            "avg_idle_s": avg_idle,
        })


def cmd_pool_builds(args):
    """Cluster pool details for a specific build."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time(ci_cluster_claim_wait_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    if not results:
        emit({"error": f"No cluster pool data for build {bid}"})
        return
    m = results[0]["metric"]
    wait = round(val(results[0]), 1)
    info = {
        "build_id": bid,
        "cluster_pool": m.get("cluster_pool"),
        "ocp_version": m.get("ocp_version"),
        "cloud_region": m.get("cloud_region"),
        "power_state": m.get("power_state"),
        "claim_wait_s": wait,
    }
    # Install duration
    install_r = vm_query(
        f'last_over_time(ci_cluster_install_duration_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    if install_r:
        info["install_duration_s"] = round(val(install_r[0]), 1)
    # Idle time
    idle_r = vm_query(
        f'last_over_time(ci_cluster_idle_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    if idle_r:
        info["idle_s"] = round(val(idle_r[0]), 1)
    emit(info)


# --- Resource utilization ---

def cmd_node_utilization(args):
    """Build cluster node utilization: actual usage vs capacity."""
    window = args[0] if args else "7d"
    limit = int(args[1]) if len(args) > 1 else 20
    # Average CPU utilization per node
    results = vm_query(
        f"topk({limit},"
        f"  avg_over_time(ci_nodes_usage_stats_avg_cpu_milli[{window}])"
        f"  / avg_over_time(ci_nodes_resources_capacity_cpu_milli[{window}])"
        f"  * 100"
        f")"
    )
    for r in results:
        m = r["metric"]
        cpu_pct = round(val(r), 1)
        emit({
            "node": m.get("node"),
            "machine_type": m.get("machine_type"),
            "cpu_util_pct": cpu_pct,
        })
    # Memory utilization summary
    mem_results = vm_query(
        f"topk({limit},"
        f"  avg_over_time(ci_nodes_usage_stats_avg_memory_bytes[{window}])"
        f"  / avg_over_time(ci_nodes_resources_capacity_memory_bytes[{window}])"
        f"  * 100"
        f")"
    )
    for r in mem_results:
        m = r["metric"]
        emit({
            "node": m.get("node"),
            "machine_type": m.get("machine_type"),
            "mem_util_pct": round(val(r), 1),
        })


# --- Test cluster utilization ---

def cmd_test_cluster_utilization(args):
    """Avg/max CPU and memory utilization from test clusters (workers only)."""
    window = args[0] if args else "7d"
    GiB = 1024 ** 3
    # Filter to worker entries (no master role label) for accurate capacity/usage
    worker_filter = 'label_node_role_kubernetes_io=""'
    cpu_usage = vm_scalar(
        f"avg(last_over_time(ci_test_cluster_cluster_cpu_usage_cores_sum{{{worker_filter}}}[{window}]))"
    )
    cpu_capacity = vm_scalar(
        f"avg(last_over_time(ci_test_cluster_cluster_capacity_cpu_cores_sum{{{worker_filter}}}[{window}]))"
    )
    mem_usage = vm_scalar(
        f"avg(last_over_time(ci_test_cluster_cluster_memory_usage_bytes_sum{{{worker_filter}}}[{window}]))"
    )
    mem_capacity = vm_scalar(
        f"avg(last_over_time(ci_test_cluster_cluster_capacity_memory_bytes_sum{{{worker_filter}}}[{window}]))"
    )
    max_cpu_usage = vm_scalar(
        f"max(last_over_time(ci_test_cluster_cluster_cpu_usage_cores_sum{{{worker_filter}}}[{window}]))"
    )
    max_mem_usage = vm_scalar(
        f"max(last_over_time(ci_test_cluster_cluster_memory_usage_bytes_sum{{{worker_filter}}}[{window}]))"
    )
    builds = vm_scalar(
        f"count(group by (build_id) (last_over_time(ci_test_cluster_cluster_cpu_usage_cores_sum{{{worker_filter}}}[{window}])))"
    )
    emit({
        "window": window,
        "builds_with_data": int(builds),
        "worker_cpu_usage_cores": round(cpu_usage, 2),
        "worker_cpu_capacity_cores": round(cpu_capacity, 2),
        "worker_cpu_util_pct": round(cpu_usage / cpu_capacity * 100, 1) if cpu_capacity else 0,
        "worker_max_cpu_cores": round(max_cpu_usage, 2),
        "worker_memory_usage_gib": round(mem_usage / GiB, 1) if mem_usage else 0,
        "worker_memory_capacity_gib": round(mem_capacity / GiB, 1) if mem_capacity else 0,
        "worker_memory_util_pct": round(mem_usage / mem_capacity * 100, 1) if mem_capacity else 0,
        "worker_max_memory_gib": round(max_mem_usage / GiB, 1) if max_mem_usage else 0,
        "note": "memory_usage includes cache/buffers; per-node working set is lower (use test-cluster-build for details)",
    })


def cmd_test_cluster_build(args):
    """Utilization details for a specific build's test cluster."""
    bid = require_arg(args, "build_id")
    GiB = 1024 ** 3
    # Get capacity and usage, split by role (master vs worker)
    cap_results = vm_query(
        f'last_over_time(ci_test_cluster_cluster_capacity_cpu_cores_sum{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    cpu_results = vm_query(
        f'last_over_time(ci_test_cluster_cluster_cpu_usage_cores_sum{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    mem_cap_results = vm_query(
        f'last_over_time(ci_test_cluster_cluster_capacity_memory_bytes_sum{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    mem_results = vm_query(
        f'last_over_time(ci_test_cluster_cluster_memory_usage_bytes_sum{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    if not cap_results and not cpu_results:
        emit({"error": f"No test cluster utilization data for build {bid}"})
        return
    # Emit per-role summary (master and worker have separate metric entries)
    for cap in cap_results:
        role_label = cap["metric"].get("label_node_role_kubernetes_io", "")
        role = "master" if role_label == "master" else "worker"
        itype = cap["metric"].get("label_beta_kubernetes_io_instance_type", "")
        cpu_cap = val(cap)
        # Find matching usage entry
        cpu_usage = 0
        for r in cpu_results:
            r_role = r["metric"].get("label_node_role_kubernetes_io", "")
            if (r_role == "master") == (role == "master"):
                cpu_usage = val(r)
        mem_cap = 0
        mem_usage = 0
        for r in mem_cap_results:
            r_role = r["metric"].get("label_node_role_kubernetes_io", "")
            if (r_role == "master") == (role == "master"):
                mem_cap = val(r)
        for r in mem_results:
            r_role = r["metric"].get("label_node_role_kubernetes_io", "")
            if (r_role == "master") == (role == "master"):
                mem_usage = val(r)
        entry = {
            "build_id": bid,
            "role": role,
            "instance_type": itype,
            "cpu_capacity_cores": round(cpu_cap, 0),
            "cpu_usage_cores": round(cpu_usage, 2),
            "cpu_util_pct": round(cpu_usage / cpu_cap * 100, 1) if cpu_cap else 0,
            "memory_capacity_gib": round(mem_cap / GiB, 1) if mem_cap else 0,
            "memory_usage_gib": round(mem_usage / GiB, 1) if mem_usage else 0,
            "memory_util_pct": round(mem_usage / mem_cap * 100, 1) if mem_cap else 0,
        }
        emit(entry)
    # Per-node memory working set (excludes cache/buffers)
    # The role label is added at ingestion from kube_node_role in the test cluster TSDB.
    node_mem = vm_query(
        f'last_over_time(ci_test_cluster_instance_node_memory_utilisation_ratio{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    node_total = vm_query(
        f'last_over_time(ci_test_cluster_node_memory_memtotal_bytes{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    totals = {r["metric"].get("instance", ""): val(r) / GiB for r in node_total}
    for r in node_mem:
        inst = r["metric"].get("instance", "")
        ratio = val(r)
        total_gib = totals.get(inst, 0)
        role = r["metric"].get("role", "")
        emit({
            "node": inst,
            "role": role,
            "working_set_pct": round(ratio * 100, 1),
            "working_set_gib": round(ratio * total_gib, 1),
            "total_gib": round(total_gib, 0),
        })


# --- Config hash ---

def cmd_config_versions(args):
    """List distinct config hashes with build counts and date ranges."""
    window = args[0] if args else "90d"
    results = vm_query(
        f'count by (config_hash) (last_over_time('
        f'ci_config_hash{{config_hash=~".+"}}[{window}]))'
    )
    if not results:
        emit({"error": "No config hash data found"})
        return
    for r in sorted(results, key=lambda x: -val(x)):
        h = r["metric"].get("config_hash", "")
        count = int(val(r))
        # Get date range for this hash
        first_r = vm_query(
            f'min(last_over_time(ci_config_hash{{config_hash="{h}"}}[{window}]))'
        )
        last_r = vm_query(
            f'max(last_over_time(ci_config_hash{{config_hash="{h}"}}[{window}]))'
        )
        entry = {"config_hash": h, "build_count": count}
        if first_r:
            entry["first_seen_ts"] = first_r[0]["value"][0]
        if last_r:
            entry["last_seen_ts"] = last_r[0]["value"][0]
        emit(entry)


def cmd_config_diff(args):
    """Compare step graph contents between two config hashes."""
    if len(args) < 2:
        emit_error("Usage: config-diff <hash1> <hash2>")
        sys.exit(1)
    hash1, hash2 = args[0], args[1]

    def get_steps(h):
        entries = vl_query(f'source:step_graph AND config_hash:{h}', 500)
        steps = {}
        for e in entries:
            name = e.get("step_name", "")
            if name and name not in steps:
                steps[name] = {
                    "description": e.get("_msg", ""),
                    "dependencies": e.get("dependencies", "[]"),
                }
        return steps

    steps1 = get_steps(hash1)
    steps2 = get_steps(hash2)
    all_names = sorted(set(steps1) | set(steps2))

    if not steps1 and not steps2:
        emit({"error": "No step graph data found for either hash"})
        return

    for name in all_names:
        in1 = name in steps1
        in2 = name in steps2
        if in1 and not in2:
            emit({"step": name, "change": "removed", **steps1[name]})
        elif in2 and not in1:
            emit({"step": name, "change": "added", **steps2[name]})
        elif steps1[name] != steps2[name]:
            emit({
                "step": name, "change": "modified",
                "before": steps1[name], "after": steps2[name],
            })
    unchanged = sum(1 for n in all_names if n in steps1 and n in steps2 and steps1[n] == steps2[n])
    emit({
        "summary": {
            "hash1": hash1, "hash2": hash2,
            "added": sum(1 for n in all_names if n not in steps1),
            "removed": sum(1 for n in all_names if n not in steps2),
            "modified": sum(1 for n in all_names if n in steps1 and n in steps2 and steps1[n] != steps2[n]),
            "unchanged": unchanged,
        }
    })


