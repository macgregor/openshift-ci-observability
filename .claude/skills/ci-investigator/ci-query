#!/usr/bin/env python3
"""CI query tool for the ci-investigator skill.

Queries VictoriaMetrics (metrics) and VictoriaLogs (logs) for CI investigation.
Each subcommand outputs JSON lines (one JSON object per line).

Usage: ci-query <command> [args...]
Run 'ci-query help' for the full command list.

To add a new subcommand:
1. Define a function cmd_<name>(args)
2. Register it in the COMMANDS dict at the bottom
3. Use emit() for each output record, emit_error() for errors
"""

import json
import os
import sys
import urllib.request
import urllib.parse
from collections import Counter

VM_URL = os.environ.get("VM_URL", "http://localhost:8428")
VL_URL = os.environ.get("VL_URL", "http://localhost:9428")
LOOKBACK = "90d"
REPO_FILTER = ""  # set by --repo flag; empty means all repos

# Shorthand for the long metric name used in most build-outcome queries
_OUTCOME = "ci_test_platform_insights_additional_context_duration_seconds"


# --- Helpers ---

import re

def _inject_repo(promql):
    """Inject repo filter into all PromQL label selectors."""
    if not REPO_FILTER:
        return promql
    label = f'repo="{REPO_FILTER}"'
    def add(m):
        inside = m.group(1)
        if 'repo=' in inside:
            return m.group(0)
        return '{' + inside + ',' + label + '}' if inside.strip() else '{' + label + '}'
    result = re.sub(r'\{([^}]*)\}', add, promql)
    # Handle bare metric names with no {} selector (e.g. "metric_name[5m]" or "metric_name)")
    result = re.sub(r'(ci_\w+)(\[|(?=\)))', rf'\1{{{label}}}\2', result)
    return result


def _inject_repo_logsql(logsql):
    """Inject repo filter into a LogsQL query."""
    if not REPO_FILTER:
        return logsql
    return f'repo:"{REPO_FILTER}" AND {logsql}'


def vm_query(query):
    """Run a PromQL instant query. Returns list of result dicts."""
    query = _inject_repo(query)
    url = f"{VM_URL}/api/v1/query"
    data = urllib.parse.urlencode({"query": query}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data), timeout=30) as resp:
            body = json.loads(resp.read())
    except urllib.error.URLError as e:
        emit_error(f"VictoriaMetrics not reachable at {VM_URL}: {e}")
        sys.exit(1)
    if body.get("status") != "success":
        emit_error(f"Query failed: {body.get('error', 'unknown')}")
        sys.exit(1)
    return body["data"]["result"]


def vm_scalar(query):
    """Run a query expecting a single scalar. Returns float or 0."""
    r = vm_query(query)
    return float(r[0]["value"][1]) if r else 0


def vl_query(query, limit=50):
    """Run a LogsQL query. Returns list of dicts."""
    query = _inject_repo_logsql(query)
    params = urllib.parse.urlencode({"query": query, "limit": limit})
    url = f"{VL_URL}/select/logsql/query?{params}"
    try:
        with urllib.request.urlopen(url, timeout=30) as resp:
            text = resp.read().decode()
    except urllib.error.URLError as e:
        emit_error(f"VictoriaLogs not reachable at {VL_URL}: {e}")
        sys.exit(1)
    return [json.loads(line) for line in text.strip().split("\n") if line.strip()]


def emit(obj):
    """Print one JSON object per line."""
    json.dump(obj, sys.stdout, separators=(",", ":"))
    print()


def emit_error(msg):
    json.dump({"error": msg}, sys.stderr, separators=(",", ":"))
    print(file=sys.stderr)


def require_arg(args, name):
    if not args:
        emit_error(f"Missing required argument: {name}")
        sys.exit(1)
    return args[0]


def val(r):
    """Extract float value from a VM result entry."""
    return float(r["value"][1])


# --- Phase 1: Triage ---

def cmd_health(args):
    """Combined health snapshot: success rate, build counts, infra latency."""
    window = args[0] if args else "24h"
    total = vm_scalar(
        f'count(last_over_time({_OUTCOME}{{name="execution_completed"}}[{window}]))'
    )
    passed = vm_scalar(
        f'count(last_over_time({_OUTCOME}{{name="execution_completed",success="true"}}[{window}]))'
    )
    avg_lat = vm_scalar(
        f"avg(last_over_time(ci_pod_scheduling_latency_seconds[{window}]))"
    )
    max_lat = vm_scalar(
        f"max(last_over_time(ci_pod_scheduling_latency_seconds[{window}]))"
    )
    builds = vm_scalar(f'count(last_over_time(ci_pipeline_scraped{{pipeline="metrics"}}[{window}]))')
    emit({
        "window": window,
        "builds_ingested": int(builds),
        "total_builds": int(total),
        "passed_builds": int(passed),
        "failed_builds": int(total - passed),
        "success_rate_pct": round(passed / total * 100, 1) if total else 0,
        "avg_scheduling_latency_s": round(avg_lat, 1),
        "max_scheduling_latency_s": round(max_lat, 1),
    })


def cmd_top_failing_steps(args):
    """Top steps by failure count (distinct builds)."""
    window = args[0] if args else "24h"
    limit = int(args[1]) if len(args) > 1 else 10
    results = vm_query(
        f"topk({limit}, count by (source) (count_over_time("
        f'(group by (build_id, source) (ci_step_duration_seconds{{level="Error"}}))'
        f"[{window}:])))"
    )
    for r in results:
        emit({"source": r["metric"]["source"], "failure_count": int(val(r))})


def cmd_top_failing_prs(args):
    """Top PRs by failure count (distinct builds)."""
    window = args[0] if args else "24h"
    limit = int(args[1]) if len(args) > 1 else 10
    results = vm_query(
        f"topk({limit}, count by (pr_number) (count_over_time("
        f"(group by (build_id, pr_number) ("
        f'{_OUTCOME}{{name="execution_completed",success="false",pr_number=~".+"}}))'
        f"[{window}:])))"
    )
    for r in results:
        emit({"pr_number": r["metric"]["pr_number"], "failure_count": int(val(r))})


# --- Discovery ---

def cmd_list_jobs(args):
    """List job names with build counts."""
    results = vm_query(
        f"count by (job_name) (last_over_time("
        f'{_OUTCOME}{{name="execution_completed"}}[{LOOKBACK}]))'
    )
    for r in sorted(results, key=lambda x: -val(x)):
        emit({"job_name": r["metric"]["job_name"], "build_count": int(val(r))})


def cmd_list_prs(args):
    """List PR numbers with build counts."""
    limit = int(args[0]) if args else 20
    results = vm_query(
        f"topk({limit}, count by (pr_number) ("
        f'last_over_time({_OUTCOME}{{name="execution_completed",pr_number=~".+"}}[{LOOKBACK}])))'
    )
    for r in results:
        emit({"pr_number": r["metric"]["pr_number"], "build_count": int(val(r))})


# --- Phase 2: Scope ---

def cmd_builds_for_pr(args):
    """All builds for a PR with outcome and duration."""
    pr = require_arg(args, "pr_number")
    results = vm_query(
        f'last_over_time({_OUTCOME}{{name="execution_completed",pr_number="{pr}"}}[{LOOKBACK}])'
    )
    for r in results:
        m = r["metric"]
        emit({
            "build_id": m.get("build_id"),
            "job_name": m.get("job_name"),
            "success": m.get("success"),
            "duration_s": round(val(r), 1),
            "pr_sha": m.get("pr_sha"),
            "author": m.get("author"),
        })


def cmd_build_info(args):
    """Single build details."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time({_OUTCOME}{{name="execution_completed",build_id="{bid}"}}[{LOOKBACK}])'
    )
    if not results:
        emit({"error": f"Build {bid} not found"})
        return
    m = results[0]["metric"]
    emit({
        "build_id": m.get("build_id"),
        "job_name": m.get("job_name"),
        "pr_number": m.get("pr_number"),
        "pr_sha": m.get("pr_sha"),
        "success": m.get("success"),
        "duration_s": round(val(results[0]), 1),
        "author": m.get("author"),
        "org": m.get("org"),
        "repo": m.get("repo"),
        "branch": m.get("branch"),
    })


# --- Phase 3: Investigate ---

def cmd_step_failures(args):
    """Failed steps for a build."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time(ci_step_duration_seconds{{level="Error",build_id="{bid}"}}[{LOOKBACK}])'
    )
    for r in results:
        emit({
            "source": r["metric"].get("source"),
            "duration_s": round(val(r), 1),
        })


def cmd_step_timeline(args):
    """All steps for a build, sorted by duration descending."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time(ci_step_duration_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    for r in sorted(results, key=lambda x: -val(x)):
        m = r["metric"]
        emit({
            "source": m.get("source"),
            "duration_s": round(val(r), 1),
            "level": m.get("level"),
            "failed": m.get("level") == "Error",
        })


def cmd_step_offsets(args):
    """Step start times relative to pipeline start, sorted chronologically."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time(ci_step_relative_start_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    for r in sorted(results, key=lambda x: val(x)):
        emit({
            "source": r["metric"].get("source"),
            "offset_s": round(val(r), 1),
        })


def cmd_pod_outcomes(args):
    """Pod phase outcomes for a build."""
    bid = require_arg(args, "build_id")
