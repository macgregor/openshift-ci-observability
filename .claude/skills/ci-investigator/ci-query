        })


def cmd_all_logs(args):
    """All logs for a build (context expansion)."""
    bid = require_arg(args, "build_id")
    limit = int(args[1]) if len(args) > 1 else 200
    for e in vl_query(f"build_id:{bid}", limit):
        emit({
            "_time": e.get("_time"),
            "_msg": e.get("_msg"),
            "level": e.get("level"),
            "source": e.get("source"),
            "component": e.get("component"),
        })


def cmd_search_logs(args):
    """Search logs by regex pattern within a build."""
    bid = require_arg(args, "build_id")
    if len(args) < 2:
        emit_error("Missing required argument: pattern")
        sys.exit(1)
    pattern = args[1]
    limit = int(args[2]) if len(args) > 2 else 30
    for e in vl_query(f'build_id:{bid} AND _msg:~"{pattern}"', limit):
        emit({
            "_time": e.get("_time"),
            "_msg": e.get("_msg"),
            "level": e.get("level"),
            "source": e.get("source"),
        })


def cmd_flakiness(args):
    """Detect flaky outcomes for a PR (mix of pass and fail)."""
    pr = require_arg(args, "pr_number")
    results = vm_query(
        f'last_over_time({_OUTCOME}{{name="execution_completed",pr_number="{pr}"}}[{LOOKBACK}])'
    )
    if not results:
        emit({"error": f"No builds found for PR #{pr}"})
        return
    outcomes = [r["metric"]["success"] for r in results]
    total = len(outcomes)
    passed = outcomes.count("true")
    is_flaky = 0 < passed < total
    emit({
        "pr_number": pr,
        "total_builds": total,
        "passed": passed,
        "failed": total - passed,
        "success_rate_pct": round(passed / total * 100, 1),
        "flaky": is_flaky,
    })
    if is_flaky:
        for r in results:
            m = r["metric"]
            emit({
                "build_id": m.get("build_id"),
                "success": m.get("success"),
                "pr_sha": m.get("pr_sha"),
                "duration_s": round(val(r), 1),
            })


def cmd_step_consistency(args):
    """Step failure consistency across builds for a PR."""
    pr = require_arg(args, "pr_number")
    results = vm_query(
        f'last_over_time(ci_step_duration_seconds{{level="Error",pr_number="{pr}"}}[{LOOKBACK}])'
    )
    if not results:
        emit({"pr_number": pr, "total_failures": 0, "builds_with_failures": 0, "steps": []})
        return
    step_counts = Counter(r["metric"]["source"] for r in results)
    build_ids = set(r["metric"]["build_id"] for r in results)
    emit({
        "pr_number": pr,
        "total_failures": len(results),
        "builds_with_failures": len(build_ids),
        "steps": [
            {"source": step, "count": count}
            for step, count in step_counts.most_common()
        ],
    })


def cmd_build_latency(args):
    """Scheduling latency aggregated by pod type (build cluster vs ephemeral)."""
    window = args[0] if args else "7d"
    # Build pods run on the shared CI build cluster; everything else runs on the ephemeral claimed cluster
    for label, filter_expr in [
        ("build_cluster", 'pod_name=~".*-build"'),
        ("ephemeral_cluster", 'pod_name!~".*-build"'),
    ]:
        results = vm_query(
            f"last_over_time(ci_pod_scheduling_latency_seconds{{{filter_expr}}}[{window}])"
        )
        if not results:
            emit({"location": label, "total_pods": 0})
            continue
        latencies = [val(r) for r in results]
        emit({
            "location": label,
            "total_pods": len(latencies),
            "pods_gt_60s": sum(1 for l in latencies if l > 60),
            "pods_gt_120s": sum(1 for l in latencies if l > 120),
            "avg_latency_s": round(sum(latencies) / len(latencies), 1),
            "max_latency_s": round(max(latencies), 1),
        })


def cmd_error_impact(args):
    """Count unique builds and PRs affected by a log search pattern."""
    pattern = require_arg(args, "pattern")
    window = args[1] if len(args) > 1 else "7d"
    limit = int(args[2]) if len(args) > 2 else 500
    entries = vl_query(f'_time:{window} AND _msg:~"{pattern}"', limit)
    builds = {}
    for e in entries:
        bid = e.get("build_id", "")
        if bid and bid not in builds:
            builds[bid] = e.get("pr_number", "")
    prs = set(pr for pr in builds.values() if pr)
    emit({
        "pattern": pattern,
        "window": window,
        "unique_builds": len(builds),
        "unique_prs": len(prs),
    })
    # Group by PR for summary
    pr_counts = Counter(builds.values())
    for pr, count in pr_counts.most_common():
        if pr:
            emit({"pr_number": pr, "affected_builds": count})


def cmd_step_errors(args):
    """Error logs across builds where a specific step failed."""
    step = require_arg(args, "step_source")
    window = args[1] if len(args) > 1 else "24h"
    max_builds = int(args[2]) if len(args) > 2 else 20
    # Find builds where this step failed
    results = vm_query(
        f'last_over_time(ci_step_duration_seconds{{level="Error",source="{step}"}}[{window}])'
    )
    if not results:
        emit({"error": f"No failures found for step {step} in {window}"})
        return
    build_ids = [r["metric"]["build_id"] for r in results]
    emit({
        "step": step,
        "window": window,
        "builds_with_failure": len(build_ids),
        "sampling": min(max_builds, len(build_ids)),
    })
    # Fetch error logs from a sample of failing builds
    for bid in build_ids[:max_builds]:
        entries = vl_query(f'build_id:{bid} AND level:~"(?i)error"', 10)
        for e in entries:
            emit({
                "build_id": bid,
                "pr_number": e.get("pr_number"),
                "_time": e.get("_time"),
                "_msg": e.get("_msg"),
                "source": e.get("source"),
            })


