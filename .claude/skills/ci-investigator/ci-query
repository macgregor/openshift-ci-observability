def cmd_help(_args):
    print("Usage: ci-query [--repo <repo>] <command> [args...]")
    print()
    print("  --repo <repo>  Filter all queries to a specific repo (e.g. cluster-monitoring-operator)")
    print()
    max_name = max(len(n) for n in COMMANDS)
    max_usage = max(len(u) for _, u, _ in COMMANDS.values())
    for name in sorted(COMMANDS):
        _, usage, desc = COMMANDS[name]
        print(f"  {name:<{max_name}}  {usage:<{max_usage}}  {desc}")


if __name__ == "__main__":
    argv = sys.argv[1:]
    # Parse --repo flag before command dispatch
    if "--repo" in argv:
        idx = argv.index("--repo")
        if idx + 1 < len(argv):
            REPO_FILTER = argv[idx + 1]
            argv = argv[:idx] + argv[idx + 2:]
        else:
            emit_error("--repo requires a value")
            sys.exit(1)
    cmd = argv[0] if argv else "help"
    if cmd in ("help", "--help", "-h"):
        cmd_help([])
        sys.exit(0)
    if cmd not in COMMANDS:
        emit_error(f"Unknown command: {cmd}")
        cmd_help([])
        sys.exit(1)
    COMMANDS[cmd][0](argv[1:])
