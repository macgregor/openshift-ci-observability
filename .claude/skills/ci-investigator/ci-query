def cmd_scheduling_latency(args):
    """Pod scheduling latency for a build."""
    bid = require_arg(args, "build_id")
    results = vm_query(
        f'last_over_time(ci_pod_scheduling_latency_seconds{{build_id="{bid}"}}[{LOOKBACK}])'
    )
    for r in results:
        emit({
            "pod_name": r["metric"].get("pod_name"),
