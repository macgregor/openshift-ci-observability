{
  "uid": "ci-logs",
  "title": "CI Logs",
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "query": "label_values(ci_build_duration_seconds, repo)",
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warning,info,debug,trace",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 0
      },
      {
        "name": "pr_number",
        "label": "PR",
        "type": "query",
        "query": "label_values(ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",repo=~\"$repo\"}, pr_number)",
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 3
      },
      {
        "name": "build_id",
        "label": "Build",
        "type": "query",
        "query": "label_values(ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",pr_number=~\"$pr_number\",repo=~\"$repo\"}, build_id)",
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 3
      },
      {
        "name": "source",
        "label": "Source",
        "type": "custom",
        "query": "ci-operator",
        "multi": true,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "ci-operator",
          "value": "ci-operator"
        },
        "sort": 0
      },
      {
        "name": "logquery",
        "label": "Filter",
        "description": "Additional LogsQL filter (e.g. _msg:~\"timeout\")",
        "type": "textbox",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 50,
      "title": "Dashboard Guide",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": true,
      "panels": [
        {
          "id": 51,
          "title": "",
          "type": "text",
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 1
          },
          "options": {
            "mode": "markdown",
            "content": "### Reading this dashboard\n\nSet **Level** to \"error\" to see failures across all builds, then narrow with **PR** or **Build**. Each log source gets its own panel to preserve ordering.\n\nUse the **Filter** box for LogsQL expressions:\n\n| Goal | Filter value |\n|------|--------|\n| Timeout errors | `_msg:~\"timeout\"` |\n| Step failures | `_msg:~\"step.*failed\"` |\n| Specific component | `component:metricsAgent` |"
          }
        }
      ]
    },
    {
      "id": 1,
      "title": "Logs: $source",
      "type": "logs",
      "gridPos": {
        "h": 25,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource"
      },
      "targets": [
        {
          "expr": "repo:~\"${repo:pipe}\" AND source:$source AND level:~\"${level:pipe}\" AND pr_number:~\"${pr_number:pipe}\" AND build_id:~\"${build_id:pipe}\" $logquery",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "repeat": "source",
      "repeatDirection": "v",
      "maxPerRow": 1
    }
  ],
  "schemaVersion": 39
}
