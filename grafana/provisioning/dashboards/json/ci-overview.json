{
  "uid": "ci-overview",
  "title": "CI Overview",
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job_type",
        "label": "Job Type",
        "type": "query",
        "query": "query_result(group by (job_name) (count_over_time(ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\"}[$__range:])))",
        "regex": "/job_name=\"([^\"]+)\"/",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "outcome",
        "label": "Outcome",
        "type": "custom",
        "query": "Success : true,Failure : false",
        "multi": true,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": [
            "Success",
            "Failure"
          ],
          "value": [
            "true",
            "false"
          ]
        },
        "options": [
          {
            "text": "Success",
            "value": "true",
            "selected": true
          },
          {
            "text": "Failure",
            "value": "false",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 50,
      "title": "Dashboard Guide",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 51,
      "title": "",
      "type": "text",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "options": {
        "mode": "markdown",
        "content": "### How to use this dashboard\n\n**Summary stats** (below) show at-a-glance health for the selected time range. Click **Failed Runs** to open the CI Investigation dashboard for detailed failure analysis.\n\n**Filters:** **Job Type** narrows to specific CI jobs. **Outcome** toggles between Success, Failure, or both.\n\n**Activity** -- pipeline run volume and success rate trends. **Duration** -- execution time envelope and retests per commit. **Steps & Infrastructure** -- step time breakdown and pod scheduling overhead. **Failure Patterns** -- which steps fail most and pod phase breakdown. For individual build investigation, use the CI Investigation dashboard."
      }
    },
    {
      "id": 52,
      "title": "Summary",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false
    },
    {
      "id": 10,
      "title": "Failed Runs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=\"false\",job_name=~\"$job_type\"}))[$__range:]))",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Investigate failures",
              "url": "/d/ci-investigation/ci-investigation?var-job_type=${job_type}&from=${__from}&to=${__to}"
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "title": "Avg Retests / Commit",
      "description": "Average number of pipeline runs per (PR, SHA) pair. Higher = more retries needed.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 7 },
      "targets": [
        {
          "expr": "avg(sum by (pr_number, pr_sha) (count_over_time((group by (build_id, pr_number, pr_sha) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",job_name=~\"$job_type\"}))[$__range:])))",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 12,
      "title": "Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=\"true\",job_name=~\"$job_type\"}))[$__range:])) / count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",job_name=~\"$job_type\"}))[$__range:])) * 100",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 13,
      "title": "Active PRs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 7 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (pr_number) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",job_name=~\"$job_type\"}))[$__range:]))",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 100,
      "title": "Activity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Active Pipelines",
      "description": "Concurrent pipeline runs per bucket. Use to gauge cluster pool pressure.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Pipeline Runs",
          "refId": "A",
          "interval": "3h"
        },
        {
          "expr": "count(count_over_time((group by (pr_number) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Active PRs",
          "refId": "B",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Active PRs" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "PRs" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Pipeline Runs" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "semi-dark-green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "Success Rate",
      "description": "Percentage of pipeline runs that succeed. Drops indicate systemic issues or flaky tests.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=\"true\",job_name=~\"$job_type\"}))[$__interval:])) / count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])) * 100",
          "legendFormat": "Success %",
          "refId": "A",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 200,
      "title": "Duration",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "id": 3,
      "title": "Pipeline Duration",
      "description": "End-to-end execution time. Min/avg/max envelope shows spread.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "max(max_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Max",
          "refId": "A",
          "interval": "3h"
        },
        {
          "expr": "avg(avg_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Avg",
          "refId": "B",
          "interval": "3h"
        },
        {
          "expr": "min(min_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Min",
          "refId": "C",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Max" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Min" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "title": "Retests per Commit",
      "description": "How many times the same commit (pr+sha) runs the same job. High values = flaky tests or infra issues requiring retests.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "max(sum by (pr_number, pr_sha) (count_over_time((group by (build_id, pr_number, pr_sha) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])))",
          "legendFormat": "Max",
          "refId": "A",
          "interval": "3h"
        },
        {
          "expr": "avg(sum by (pr_number, pr_sha) (count_over_time((group by (build_id, pr_number, pr_sha) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])))",
          "legendFormat": "Avg",
          "refId": "B",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Max" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 300,
      "title": "Steps & Infrastructure",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Step Duration by Type",
      "description": "Average duration of each ci-operator step. Identifies which steps dominate pipeline runtime.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 34 },
      "targets": [
        {
          "expr": "avg by (source) (avg_over_time(ci_step_duration_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "{{source}}",
          "refId": "A",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }
      }
    },
    {
      "id": 6,
      "title": "Infrastructure Overhead",
      "description": "Pod scheduling and initialization latency. High values indicate cluster resource pressure.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 34 },
      "targets": [
        {
          "expr": "avg(avg_over_time(ci_pod_scheduling_latency_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Scheduling (avg)",
          "refId": "A",
          "interval": "3h"
        },
        {
          "expr": "max(max_over_time(ci_pod_scheduling_latency_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Scheduling (max)",
          "refId": "B",
          "interval": "3h"
        },
        {
          "expr": "avg(avg_over_time(ci_pods_initialization_latency{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Initialization (avg)",
          "refId": "C",
          "interval": "3h"
        },
        {
          "expr": "max(max_over_time(ci_pods_initialization_latency{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Initialization (max)",
          "refId": "D",
          "interval": "3h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*max.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Scheduling.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Initialization.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 350,
      "title": "Failure Patterns",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false
    },
    {
      "id": 14,
      "title": "Step Failure Leaderboard",
      "description": "Which ci-operator steps fail most often. High counts indicate flaky steps or infrastructure issues at specific phases.",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 45 },
      "targets": [
        {
          "expr": "topk(15, count by (source) (count_over_time((group by (build_id, source) (ci_step_duration_seconds{level=\"Error\",job_name=~\"$job_type\"}))[$__range:])))",
          "legendFormat": "{{source}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      }
    },
    {
      "id": 15,
      "title": "Pod Phase Breakdown",
      "description": "Distribution of pod outcomes. High Failed ratio suggests infrastructure pressure.",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 45 },
      "targets": [
        {
          "expr": "count by (pod_phase) (count_over_time((group by (build_id, pod_name, pod_phase) (ci_pods_completion_latency{job_name=~\"$job_type\",pod_phase=~\".+\"}))[$__range:]))",
          "legendFormat": "{{pod_phase}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Succeeded" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["percent"] },
        "pieType": "donut"
      }
    }
  ],
  "schemaVersion": 39
}
