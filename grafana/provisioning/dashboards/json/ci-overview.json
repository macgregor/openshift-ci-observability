{
  "uid": "ci-overview",
  "title": "CI Overview",
  "timezone": "utc",
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job_type",
        "label": "Job Type",
        "type": "query",
        "query": "label_values(ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\"}, job_name)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "outcome",
        "label": "Outcome",
        "type": "custom",
        "query": "Success : true,Failure : false",
        "multi": true,
        "includeAll": false,
        "current": { "selected": true, "text": ["Success", "Failure"], "value": ["true", "false"] },
        "options": [
          { "text": "Success", "value": "true", "selected": true },
          { "text": "Failure", "value": "false", "selected": true }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 100, "title": "Activity", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 1,
      "title": "Active Pipelines",
      "description": "Concurrent pipeline runs per bucket. Use to gauge cluster pool pressure.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Pipeline Runs",
          "refId": "A",
          "interval": "6h"
        },
        {
          "expr": "count(count_over_time((group by (pr_number) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Active PRs",
          "refId": "B",
          "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "none" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Active PRs" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }, { "id": "custom.drawStyle", "value": "line" }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineWidth", "value": 2 }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "custom.axisLabel", "value": "PRs" }] },
          { "matcher": { "id": "byName", "options": "Pipeline Runs" }, "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-green", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "title": "Success Rate",
      "description": "Percentage of pipeline runs that succeed. Drops indicate systemic issues or flaky tests.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=\"true\",job_name=~\"$job_type\"}))[$__interval:])) / count(count_over_time((group by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])) * 100",
          "legendFormat": "Success %",
          "refId": "A",
          "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "pointSize": 5, "showPoints": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 200, "title": "Duration", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 }, "collapsed": false
    },
    {
      "id": 3,
      "title": "Pipeline Duration",
      "description": "End-to-end execution time. Min/avg/max envelope shows spread.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "max(max_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Max", "refId": "A", "interval": "6h"
        },
        {
          "expr": "avg(avg_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Avg", "refId": "B", "interval": "6h"
        },
        {
          "expr": "min(min_over_time((max by (build_id) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:]))",
          "legendFormat": "Min", "refId": "C", "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "pointSize": 5, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Max" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] },
          { "matcher": { "id": "byName", "options": "Avg" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }, { "id": "custom.lineWidth", "value": 3 }] },
          { "matcher": { "id": "byName", "options": "Min" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "Retests per Commit",
      "description": "How many times the same commit (pr+sha) runs the same job. High values = flaky tests or infra issues requiring retests.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "max(sum by (pr_number, pr_sha) (count_over_time((group by (build_id, pr_number, pr_sha) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])))",
          "legendFormat": "Max", "refId": "A", "interval": "6h"
        },
        {
          "expr": "avg(sum by (pr_number, pr_sha) (count_over_time((group by (build_id, pr_number, pr_sha) (ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}))[$__interval:])))",
          "legendFormat": "Avg", "refId": "B", "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "pointSize": 5, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Max" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] },
          { "matcher": { "id": "byName", "options": "Avg" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }, { "id": "custom.lineWidth", "value": 3 }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 300, "title": "Steps & Infrastructure", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false
    },
    {
      "id": 5,
      "title": "Step Duration by Type",
      "description": "Average duration of each ci-operator step. Identifies which steps dominate pipeline runtime.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "avg by (source) (avg_over_time(ci_step_duration_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "{{source}}",
          "refId": "A",
          "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } }
    },
    {
      "id": 6,
      "title": "Infrastructure Overhead",
      "description": "Pod scheduling and initialization latency. High values indicate cluster resource pressure.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "avg(avg_over_time(ci_pod_scheduling_latency_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Scheduling (avg)", "refId": "A", "interval": "6h"
        },
        {
          "expr": "max(max_over_time(ci_pod_scheduling_latency_seconds{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Scheduling (max)", "refId": "B", "interval": "6h"
        },
        {
          "expr": "avg(avg_over_time(ci_pods_initialization_latency{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Initialization (avg)", "refId": "C", "interval": "6h"
        },
        {
          "expr": "max(max_over_time(ci_pods_initialization_latency{job_name=~\"$job_type\"}[$__interval:]))",
          "legendFormat": "Initialization (max)", "refId": "D", "interval": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "pointSize": 5, "showPoints": "auto" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*max.*" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] },
          { "matcher": { "id": "byRegexp", "options": "Scheduling.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "Initialization.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 400, "title": "Outliers", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "collapsed": false
    },
    {
      "id": 7,
      "title": "Longest Runs",
      "description": "Individual pipeline runs sorted by duration. Use to investigate outliers.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "targets": [
        {
          "expr": "topk(20, max_over_time(ci_test_platform_insights_additional_context_duration_seconds{name=\"execution_completed\",success=~\"$outcome\",job_name=~\"$job_type\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "name": true, "branch": true, "timestamp": true },
            "renameByName": {
              "pr_number": "PR",
              "pr_sha": "Commit",
              "job_name": "Job",
              "build_id": "Build ID",
              "author": "Author",
              "success": "Outcome",
              "Value": "Duration",
              "org": "org",
              "repo": "repo"
            },
            "indexByName": {
              "pr_number": 0,
              "pr_sha": 1,
              "author": 2,
              "job_name": 3,
              "success": 4,
              "Value": 5,
              "build_id": 6,
              "org": 7,
              "repo": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Job" },
            "properties": [{ "id": "custom.width", "value": 300 }]
          },
          {
            "matcher": { "id": "byName", "options": "org" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "repo" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "PR" },
            "properties": [{
              "id": "links",
              "value": [{
                "title": "GitHub PR",
                "url": "https://github.com/${__data.fields.org}/${__data.fields.repo}/pull/${__value.raw}",
                "targetBlank": true
              }]
            }]
          },
          {
            "matcher": { "id": "byName", "options": "Build ID" },
            "properties": [{
              "id": "links",
              "value": [{
                "title": "Prow Job",
                "url": "https://prow.ci.openshift.org/view/gs/test-platform-results/pr-logs/pull/${__data.fields.org}_${__data.fields.repo}/${__data.fields.PR}/${__data.fields.Job}/${__value.raw}",
                "targetBlank": true
              }]
            }]
          },
          {
            "matcher": { "id": "byName", "options": "Outcome" },
            "properties": [{
              "id": "mappings",
              "value": [
                { "type": "value", "options": { "true": { "text": "Success", "color": "green" } } },
                { "type": "value", "options": { "false": { "text": "Failure", "color": "red" } } }
              ]
            }]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Duration", "desc": true }] }
    }
  ],
  "schemaVersion": 39
}
